# ============================================================
# PERSONAL BRANCH .gitignore
# ------------------------------------------------------------
# This branch intentionally TRACKS user data (CVs, reports,
# profile, applications tracker, etc.) so it can be backed up
# to the personal fork at github.com/cyteger/career-ops.
#
# DO NOT MERGE THIS BRANCH INTO `main`. `main` is the upstream
# mirror and must stay clean. Contributions branch off
# `upstream/main`, not `personal`.
# ============================================================

# Runtime state (never useful to keep in git)
batch/logs/*
!batch/logs/.gitkeep
batch/batch-state.tsv
batch/batch-input.tsv
batch/batch-run.log
.update-dismissed
.update-lock
.playwright-mcp/

# Secrets (never commit — use .env.example as template)
.env

# Generated / build artifacts
.resolved-prompt-*
node_modules/
bun.lock
career-dashboard
package-lock.json

# OS
.DS_Store
*.mov
*.mp4

# Claude Code — local-only, not for backup
.claude/settings.local.json
.claude/memory/
